# Build output
build*/
local-builds/
out/
.cache/
compile_commands.json

# Dear ImGui window layout, written at runtime
imgui.ini

# IDE
/.vscode/*
!/.vscode/settings.json
.idea/
*.user

# flatpak-builder state (build-flatpak* is covered by build*)
.flatpak-builder/

# docs/ holds working notes that stay local; only the build guide is committed
docs/*
!docs/compilation.md

# The version suffix CI writes for snapshots (tools/snapshot-suffix.sh)
.multitap-version-suffix
